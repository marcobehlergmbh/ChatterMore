<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ChatterMore" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:colorAccent">@color/chattermore_blue</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.ChatterMore.FullscreenImage" parent="android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">#FF000000</item>
        <item name="android:colorAccent">@color/chattermore_blue</item>
    </style>

    <style name="TextAppearance.ChatterMore.MessageAuthor" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/message_author</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.ChatterMore.MessageBody" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineHeight">23sp</item>
        <item name="android:textColor">@color/message_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.ChatterMore.MessageMetadata" parent="android:style/TextAppearance.Material.Caption">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/message_metadata</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
