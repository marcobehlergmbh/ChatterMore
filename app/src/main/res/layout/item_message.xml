<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/messageDayDivider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/message_horizontal_padding"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:importantForAccessibility="yes"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/divider"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/messageDayDividerLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            style="@style/TextAppearance.ChatterMore.MessageMetadata" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/divider"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/messageRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/message_horizontal_padding"
        android:paddingVertical="@dimen/message_group_vertical_spacing">

        <View
            android:id="@+id/messageAttentionBar"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"
            android:background="@color/mention_direct_accent"
            android:importantForAccessibility="no"
            android:visibility="invisible" />

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:clipChildren="false">

            <ImageView
                android:id="@+id/messageAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/avatar_background"
                android:clipToOutline="true"
                android:contentDescription="@string/user_avatar"
                android:outlineProvider="background"
                android:padding="@dimen/message_avatar_placeholder_padding"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person" />

            <com.marcobehler.chattermore.ui.PresenceBadgeView
                android:id="@+id/messagePresence"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="start|top"
                android:layout_marginStart="28dp"
                android:layout_marginTop="28dp"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/messageContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/messageHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:gravity="center_vertical"
                android:minHeight="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/messageAuthor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:ellipsize="end"
                    android:maxLines="1"
                    style="@style/TextAppearance.ChatterMore.MessageAuthor" />

                <TextView
                    android:id="@+id/messageTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    style="@style/TextAppearance.ChatterMore.MessageMetadata" />
            </LinearLayout>

            <TextView
                android:id="@+id/messageBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColorLink="@color/chattermore_blue"
                android:textIsSelectable="true"
                style="@style/TextAppearance.ChatterMore.MessageBody" />

            <ViewStub
                android:id="@+id/messageSunoStub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inflatedId="@+id/messageSunoPlayer"
                android:layout="@layout/message_suno_player" />

            <ViewStub
                android:id="@+id/messageYouTubeStub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inflatedId="@+id/messageYouTubePreview"
                android:layout="@layout/message_youtube_preview" />

            <ViewStub
                android:id="@+id/messageLinkPreviewStub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inflatedId="@+id/messageLinkPreview"
                android:layout="@layout/message_link_preview" />

            <ViewStub
                android:id="@+id/messageImagesStub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inflatedId="@+id/messageImages"
                android:layout="@layout/message_image_grid" />

            <ViewStub
                android:id="@+id/messageFilesStub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inflatedId="@+id/messageFiles"
                android:layout="@layout/message_file_list" />

            <TextView
                android:id="@+id/messageState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                style="@style/TextAppearance.ChatterMore.MessageMetadata" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
