<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/message_horizontal_padding"
    android:paddingVertical="@dimen/message_group_vertical_spacing">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/messageAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/avatar_background"
            android:clipToOutline="true"
            android:contentDescription="@string/user_avatar"
            android:outlineProvider="background"
            android:padding="@dimen/message_avatar_placeholder_padding"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/messageHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:gravity="center_vertical"
            android:minHeight="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/messageAuthor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:maxLines="1"
                style="@style/TextAppearance.MattermostLite.MessageAuthor" />

            <TextView
                android:id="@+id/messageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                style="@style/TextAppearance.MattermostLite.MessageMetadata" />
        </LinearLayout>

        <TextView
            android:id="@+id/messageBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColorLink="@color/mattermost_blue"
            android:textIsSelectable="true"
            style="@style/TextAppearance.MattermostLite.MessageBody" />

        <ViewStub
            android:id="@+id/messageSunoStub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:inflatedId="@+id/messageSunoPlayer"
            android:layout="@layout/message_suno_player" />

        <ViewStub
            android:id="@+id/messageYouTubeStub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:inflatedId="@+id/messageYouTubePreview"
            android:layout="@layout/message_youtube_preview" />

        <ViewStub
            android:id="@+id/messageImagesStub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:inflatedId="@+id/messageImages"
            android:layout="@layout/message_image_grid" />

        <ViewStub
            android:id="@+id/messageFilesStub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:inflatedId="@+id/messageFiles"
            android:layout="@layout/message_file_list" />

        <TextView
            android:id="@+id/messageState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            style="@style/TextAppearance.MattermostLite.MessageMetadata"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
